# Copier ce fichier en ".env" puis remplir les valeurs.
# Ne JAMAIS committer le vrai fichier .env (il est dans .gitignore).

# Port de l'API en local
PORT=4000

# Connexion PostgreSQL.
#  - en local : postgres://postgres:postgres@localhost:5432/portfolio
#  - Supabase : Project Settings > Database > Connection string (mode "Session pooler")
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio

# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# Supabase (Project Settings > API). Nécessaire pour l'espace admin.
SUPABASE_URL=
SUPABASE_ANON_KEY=
